{
  "name": "meeting-room-booking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "npm run check:frontend:source && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "lint:fsd": "steiger src",
    "lint:structure": "node scripts/quality/check-structure.mjs",
    "lint:react": "react-doctor . --scope full --blocking warning --no-telemetry --no-supply-chain --yes",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "knip": "knip",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --maxWorkers=1",
    "test:coverage:storybook": "vitest run --config vitest.storybook.config.ts --coverage --maxWorkers=1",
    "test:unit": "vitest run __spec__",
    "test:integration": "vitest run tests/integration",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "test-storybook": "vitest run --config vitest.storybook.config.ts",
    "test:e2e": "playwright test",
    "test:deployment": "playwright test --config playwright.deployment.config.ts",
    "test:staging": "playwright test --config playwright.staging.config.ts",
    "check:frontend:source": "npm run lint && npm run lint:fsd && npm run lint:structure && npm run lint:react && npm run format:check && npm run knip",
    "check:frontend:runtime": "npm run test-storybook && npm run test:e2e",
    "check:frontend": "npm run typecheck && npm run build && npm run check:frontend:runtime",
    "check:i18n": "node scripts/i18n/check.mjs",
    "check:security": "node scripts/security/check.mjs --check-working-copy",
    "check:security:staged": "node scripts/security/check.mjs --staged",
    "check:staged": "node scripts/validation/pre-commit.mjs",
    "check:working-copy": "node scripts/validation/pre-commit.mjs --check-working-copy",
    "test:tooling": "vitest run scripts eslint",
    "security:check": "npm run check:security",
    "security:test": "npm run test:tooling",
    "security:install-hooks": "git config core.hooksPath .githooks",
    "validate": "npm run check:working-copy",
    "validate:commit": "npm run check:staged"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "26.4.7",
    "lucide-react": "0.454.0",
    "next": "16.4.3",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.0.20",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "0.8.0",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-vitest": "10.6.3",
    "@storybook/nextjs-vite": "10.6.3",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "eslint-plugin-storybook": "10.6.3",
    "knip": "6.38.0",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.3",
    "postcss": "^8.5.0",
    "prettier": "3.9.10",
    "react-doctor": "0.9.18",
    "steiger": "0.7.0",
    "storybook": "10.6.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.0.0",
    "vitest": "5.0.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "engines": {
    "node": "24.x"
  }
}
